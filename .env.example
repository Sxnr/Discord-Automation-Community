# ══════════════════════════════════════════════════════════════════════════
#  CONFIGURACIÓN DEL BOT — Discord Automation Community
#  Copia este archivo como ".env" y rellena los valores.
#  NUNCA subas tu .env a Git (ya está en .gitignore).
#  El bot carga estas variables con dotenv al iniciar.
# ══════════════════════════════════════════════════════════════════════════

# ── DISCORD (OBLIGATORIO) ────────────────────────────────────────────────
# Token del bot:
#   https://discord.com/developers/applications -> tu app -> Bot -> "Reset Token"
TOKEN=tu_token_aqui
# ID de la aplicación (obligatorio para /deploy):
#   misma página -> General Information -> "Application ID"
CLIENT_ID=tu_client_id_aqui
# ID de un servidor de prueba para registrar comandos al instante (opcional,
# hace que /deploy sea inmediato en vez de esperar hasta 1 hora).
GUILD_ID=

# ── MÚSICA (opcional) ─────────────────────────────────────────────────────
# Normalmente se autoconfigura con ffmpeg-static. Solo ponlo si quieres
# forzar la ruta de un ffmpeg propio.
FFMPEG_PATH=

# Si el hosting bloquea YouTube/SoundCloud (IP de datacenter), usá un proxy
# HTTP/HTTPS cuya IP NO esté bloqueada por esos servicios.
YOUTUBE_PROXY=
SOUNDCLOUD_PROXY=

# Spotify REAL (playlists y álbumes completos). Sin esto, solo funcionan
# canciones individuales de Spotify (resueltas vía búsqueda).
#   https://developer.spotify.com/dashboard -> crear app -> Client ID / Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Debug de voz del player (muy verboso). Pon "true" solo para diagnosticar.
MUSIC_DEBUG=

# ── MODERACIÓN POR IA (opcional) ─────────────────────────────────────────
# Cualquier LLM compatible con la API de OpenAI. Si no pones key, /aimod
# funciona igual con la heurística de spam/toxicidad.
# Proveedor gratuito recomendado (sin tarjeta): https://console.groq.com
#   AI_API_KEY = tu key de Groq
#   AI_API_URL = https://api.groq.com/openai/v1/chat/completions
#   AI_MODEL   = llama-3.1-8b-instant
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ── APIs EXTERNAS (opcionales, solo para comandos fun/utility) ────────────
# Si falta la key, el comando avisa amablemente qué variable falta.
# Todas las opciones abajo tienen plan gratuito SIN tarjeta de crédito,
# excepto OpenWeather (pide tarjeta pero no cobra en el plan free).

# /clima  -> https://openweathermap.org/api  (plan free, pide tarjeta)
OPENWEATHER_KEY=

# /noticias -> https://gnews.io  (free, sin tarjeta)
GNEWS_KEY=

# /peliculas y /series -> https://www.themoviedb.org/documentation/api  (free, sin tarjeta)
TMDB_KEY=

# /letra -> https://genius.com/developers  (free, sin tarjeta)
GENIUS_TOKEN=

# /action (GIFs) -> https://developers.giphy.com  (Tenor cerró su API en 2024/2025)
# Si falta, el comando usa nekos.best (anime, sin key) como fallback.
GIPHY_KEY=
